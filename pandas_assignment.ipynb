## Q7. Create a DataFrame using multiple Series.
import pandas as pd

name = pd.Series(["Alice", "Bob", "Claire"])
age = pd.Series([25, 30, 27])
gender = pd.Series(["Female", "Male", "Female"])

df = pd.DataFrame({
    "Name": name,
    "Age": age,
    "Gender": gender
})

print(df)
